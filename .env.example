# =============================================================================
# .env.example — LLM variables for the cp-* skills (CrewAI)
#
# Copy this file to `.env` at the project root and fill in your keys.
# The CrewAI skills (cp-requirements, cp-architecture, etc.) use these variables
# to build the LLM via skills/_shared/llm.py.
#
# NEVER commit the real `.env` — only this `.env.example`.
# =============================================================================

# ── LLM model (required) ────────────────────────────────────────────────────
# Format: <provider>/<model>. Examples:
#   gemini/gemini-2.5-flash
#   openai/gpt-4o
#   anthropic/claude-sonnet-4
#   ollama/llama3.1            (local, use LLM_API_BASE=http://localhost:11434)
LLM_MODEL=gemini/gemini-2.5-flash

# ── API key (required) ───────────────────────────────────────────────────────
# Use the variable of the provider you chose in LLM_MODEL.
# The helper auto-detects the key by provider:
#   gemini/google  → GEMINI_API_KEY
#   openai         → OPENAI_API_KEY
#   anthropic      → ANTHROPIC_API_KEY
#   ollama         → OLLAMA_API_KEY
#   openrouter     → OPENROUTER_API_KEY
#   deepseek       → DEEPSEEK_API_KEY
#   groq           → GROQ_API_KEY
#   mistral        → MISTRAL_API_KEY
#   cohere         → COHERE_API_KEY
#   together       → TOGETHER_API_KEY
#   xai/grok       → XAI_API_KEY
#
# Alternatively, set LLM_API_KEY explicitly (works for any provider):
# LLM_API_KEY=YOUR_KEY_HERE

# ── Optional settings ───────────────────────────────────────────────────────
# Base URL for self-hosted / OpenAI-compatible providers (e.g. Ollama, LM Studio)
# LLM_API_BASE=

# LLM temperature (default: 0.7)
# LLM_TEMPERATURE=0.7

# Explicit provider (if the model has no prefix). E.g. gemini, openai, anthropic
# LLM_PROVIDER=

# ── Examples per provider ────────────────────────────────────────────────────

# Example 1: Google Gemini
# LLM_MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=YOUR_KEY_HERE

# Example 2: OpenAI
# LLM_MODEL=openai/gpt-4o
# OPENAI_API_KEY=YOUR_KEY_HERE

# Example 3: Anthropic Claude
# LLM_MODEL=anthropic/claude-sonnet-4
# ANTHROPIC_API_KEY=YOUR_KEY_HERE

# Example 4: Local Ollama
# LLM_MODEL=ollama/llama3.1
# OLLAMA_API_KEY=*** LLM_API_BASE=http://localhost:11434

# Example 5: Claude Code as LLM (via scripts/claude_proxy.py)
# Run first: python scripts/claude_proxy.py --port 8090
# LLM_MODEL=openai/claude-sonnet-4
# LLM_API_BASE=http://localhost:8090/v1
# LLM_API_KEY=***   # the proxy ignores it, but CrewAI requires it
# LLM_PROVIDER=openai

# ── claude_proxy.py authentication (DT-04) ──
# The proxy delegates the Claude Code OAuth session, so any local process
# that reaches the port consumes your quota. By setting this token, the
# proxy starts requiring `Authorization: Bearer *** without it, it accepts
# any request (protected only by the 127.0.0.1 bind).
# Use the SAME value in LLM_API_KEY, which CrewAI already sends as Bearer.
# CLAUDE_PROXY_TOKEN=<generate-a-random-value>
