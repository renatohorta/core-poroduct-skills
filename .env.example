# =============================================================================
# .env.example — Variáveis de LLM para as skills cp-* (CrewAI)
#
# Copie este arquivo para `.env` na raiz do projeto e preencha com suas chaves.
# As skills CrewAI (cp-requisitos, cp-arquitetura, etc.) usam estas variáveis
# para construir o LLM via skills/_shared/llm.py.
#
# NUNCA commite o `.env` real — apenas este `.env.example`.
# =============================================================================

# ── Modelo do LLM (obrigatório) ─────────────────────────────────────────────
# Formato: <provider>/<modelo>. Exemplos:
#   gemini/gemini-2.5-flash
#   openai/gpt-4o
#   anthropic/claude-sonnet-4
#   ollama/llama3.1            (local, use LLM_API_BASE=http://localhost:11434)
LLM_MODEL=gemini/gemini-2.5-flash

# ── Chave da API (obrigatório) ──────────────────────────────────────────────
# Use a variável do provider que você escolheu em LLM_MODEL.
# O helper detecta automaticamente a chave pelo provider:
#   gemini/google  → GEMINI_API_KEY
#   openai         → OPENAI_API_KEY
#   anthropic      → ANTHROPIC_API_KEY
#   ollama         → OLLAMA_API_KEY
#   openrouter     → OPENROUTER_API_KEY
#   deepseek       → DEEPSEEK_API_KEY
#   groq           → GROQ_API_KEY
#   mistral        → MISTRAL_API_KEY
#   cohere         → COHERE_API_KEY
#   together       → TOGETHER_API_KEY
#   xai/grok       → XAI_API_KEY
#
# Alternativamente, defina LLM_API_KEY explicitamente (funciona para qualquer provider):
# LLM_API_KEY=SUA_CHAVE_AQUI

# ── Configurações opcionais ────────────────────────────────────────────────
# Base URL para providers self-hosted / compatíveis com OpenAI (ex: Ollama, LM Studio)
# LLM_API_BASE=

# Temperatura do LLM (default: 0.7)
# LLM_TEMPERATURE=0.7

# Provider explícito (se o modelo não tiver prefixo). Ex: gemini, openai, anthropic
# LLM_PROVIDER=

# ── Exemplos por provider ──────────────────────────────────────────────────

# Exemplo 1: Google Gemini
# LLM_MODEL=gemini/gemini-2.5-flash
# GEMINI_API_KEY=SUA_CHAVE_AQUI

# Exemplo 2: OpenAI
# LLM_MODEL=openai/gpt-4o
# OPENAI_API_KEY=SUA_CHAVE_AQUI

# Exemplo 3: Anthropic Claude
# LLM_MODEL=anthropic/claude-sonnet-4
# ANTHROPIC_API_KEY=SUA_CHAVE_AQUI

# Exemplo 4: Ollama local
# LLM_MODEL=ollama/llama3.1
# OLLAMA_API_KEY=SUA_CHAVE_AQUI
# LLM_API_BASE=http://localhost:11434
